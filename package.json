{
    "name": "certi",
    "displayName": "Certificate Utility",
    "description": "Certificate utilities for validating, decoding, inspecting, and checking X.509 certificate expiration from VS Code.",
    "version": "0.0.3",
    "publisher": "framedparadox",
    "license": "MIT",
    "icon": "resources/certificate.png",
    "keywords": [
        "certificate",
        "x509",
        "pem",
        "der",
        "ssl",
        "tls",
        "pkcs12",
        "jks",
        "expiry",
        "developer tools"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/framedparadox/cert-util-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/framedparadox/cert-util-vscode/issues"
    },
    "homepage": "https://github.com/framedparadox/cert-util-vscode#readme",
    "engines": {
        "vscode": "^1.105.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        },
        "virtualWorkspaces": {
            "supported": false,
            "description": "Certificate file access and external OpenSSL/keytool operations require a local or remote workspace file system."
        }
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "certificateUtil-explorer",
                    "title": "Certificates",
                    "icon": "resources/icons/certificate.svg"
                }
            ]
        },
        "views": {
            "certificateUtil-explorer": [
                {
                    "id": "certificateUtilToolsView",
                    "name": "Certificate Tools",
                    "icon": "resources/icons/certificate.svg",
                    "type": "webview"
                }
            ]
        },
        "commands": [
            {
                "command": "certificateUtil.openCertificateTools",
                "title": "Open Certificate Tools",
                "category": "Certificate Utility",
                "icon": "$(shield)"
            },
            {
                "command": "certificateUtil.openCertificateOperations",
                "title": "Open Certificate Conversion & Keystore",
                "category": "Certificate Utility",
                "icon": "$(key)"
            },
            {
                "command": "certificateUtil.inspectActiveCertificate",
                "title": "Inspect Active Certificate",
                "category": "Certificate Utility",
                "icon": "$(file-code)"
            },
            {
                "command": "certificateUtil.inspectCertificateFile",
                "title": "Inspect Certificate File",
                "category": "Certificate Utility",
                "icon": "$(folder-opened)"
            },
            {
                "command": "certificateUtil.inspectRemoteCertificate",
                "title": "Inspect Remote Certificate",
                "category": "Certificate Utility",
                "icon": "$(globe)"
            },
            {
                "command": "certificateUtil.openInspectTool",
                "title": "Open Inspect Tool",
                "category": "Certificate Utility",
                "icon": "$(search)"
            },
            {
                "command": "certificateUtil.openValidateTool",
                "title": "Open Validate Tool",
                "category": "Certificate Utility",
                "icon": "$(verified)"
            },
            {
                "command": "certificateUtil.openChainTool",
                "title": "Open Chain Tool",
                "category": "Certificate Utility",
                "icon": "$(list-tree)"
            },
            {
                "command": "certificateUtil.openConvertTool",
                "title": "Open Convert Tool",
                "category": "Certificate Utility",
                "icon": "$(arrow-swap)"
            },
            {
                "command": "certificateUtil.openKeystoreTool",
                "title": "Open Keystore Tool",
                "category": "Certificate Utility",
                "icon": "$(database)"
            },
            {
                "command": "certificateUtil.openRemoteTool",
                "title": "Open Remote Tool",
                "category": "Certificate Utility",
                "icon": "$(globe)"
            },
            {
                "command": "certificateUtil.openExpiryChecker",
                "title": "Open Certificate Expiry Checker",
                "category": "Certificate Utility",
                "icon": "$(calendar)"
            },
            {
                "command": "certificateUtil.openGenerateTool",
                "title": "Open Certificate Generator",
                "category": "Certificate Utility",
                "icon": "$(new-file)"
            },
            {
                "command": "certificateUtil.verifyKeyMatchesCertificate",
                "title": "Inspect Private Key and Certificate Match",
                "category": "Certificate Utility",
                "icon": "$(key)"
            },
            {
                "command": "certificateUtil.compareCertificates",
                "title": "Open Certificate Comparison",
                "category": "Certificate Utility",
                "icon": "$(diff)"
            },
            {
                "command": "certificateUtil.checkRemoteWatchlist",
                "title": "Open Remote Watchlist Report",
                "category": "Certificate Utility",
                "icon": "$(broadcast)"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "certificateUtil.inspectCertificateFile",
                    "when": "resourceExtname =~ /\\.(pem|crt|cer|cert|der|ca-bundle|ca|bundle|p12|pfx|p7b|p7c|p7s|csr|key|jks)$/",
                    "group": "navigation@90"
                }
            ],
            "editor/context": [
                {
                    "command": "certificateUtil.inspectActiveCertificate",
                    "when": "resourceExtname =~ /\\.(pem|crt|cer|cert|der|ca-bundle|ca|bundle|csr|key)$/",
                    "group": "navigation@90"
                }
            ],
            "editor/title": [
                {
                    "command": "certificateUtil.inspectActiveCertificate",
                    "when": "resourceExtname =~ /\\.(pem|crt|cer|cert|der|ca-bundle|ca|bundle|csr|key)$/",
                    "group": "navigation"
                }
            ]
        },
        "customEditors": [
            {
                "viewType": "certificateUtil.certificateViewer",
                "displayName": "Certificate Viewer",
                "selector": [
                    {
                        "filenamePattern": "*.{pem,crt,cer,cert,der,ca-bundle,ca,bundle,p7b,p7c}"
                    }
                ],
                "priority": "option"
            }
        ],
        "configuration": {
            "title": "Certificate Utility",
            "properties": {
                "certificateUtil.expiryWarningDays": {
                    "type": "number",
                    "default": 30,
                    "minimum": 1,
                    "markdownDescription": "Number of days before a certificate's expiry date at which it is reported as **expiring soon** in validation results, the expiry scanner, and the status bar."
                },
                "certificateUtil.defaultRemotePort": {
                    "type": "number",
                    "default": 443,
                    "minimum": 1,
                    "maximum": 65535,
                    "description": "Default TCP port assumed when a remote TLS endpoint is entered without an explicit port."
                },
                "certificateUtil.opensslPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the OpenSSL executable. Leave empty to use 'openssl' from the system PATH. OpenSSL is only required for conversion and keystore operations."
                },
                "certificateUtil.keytoolPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Java keytool executable. Leave empty to use 'keytool' from the system PATH. keytool is only required for JKS keystore operations."
                },
                "certificateUtil.remoteWatchlist": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Remote TLS endpoints (`host:port`) to monitor with the **Open Remote Watchlist Report** command. Example: `example.com:443`."
                }
            }
        }
    },
    "scripts": {
        "postinstall": "npm run compile",
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run format:check && npm run lint && npm run compile-tests && npm run package",
        "test": "vscode-test",
        "build": "webpack --mode development",
        "package:vsix": "vsce package --no-dependencies --out certi.vsix"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "22.x",
        "@types/node-forge": "^1.3.14",
        "@types/vscode": "1.105.0",
        "@typescript-eslint/eslint-plugin": "^8.45.0",
        "@typescript-eslint/parser": "^8.45.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "@vscode/vsce": "^3.9.2",
        "eslint": "^9.36.0",
        "prettier": "^3.6.2",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "webpack": "^5.102.0",
        "webpack-cli": "^6.0.1"
    },
    "overrides": {
        "mocha": {
            "diff": "9.0.0",
            "serialize-javascript": "7.0.6"
        }
    },
    "dependencies": {
        "@peculiar/asn1-schema": "^2.8.0",
        "@peculiar/asn1-x509": "^2.8.0",
        "@peculiar/x509": "^2.0.0",
        "node-forge": "^1.4.0",
        "pkijs": "^3.4.0",
        "reflect-metadata": "^0.2.2"
    }
}
